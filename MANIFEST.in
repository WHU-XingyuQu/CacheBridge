include .gitmodules
include .gitattributes
include README.md CONTRIBUTING.md LICENSE_STATUS.md THIRD_PARTY_NOTICES.md
graft integrations
graft benchmarks
graft recipes
recursive-include docs *.md
recursive-include examples *.py
recursive-include tests *.py
global-exclude *.safetensors *.pt *.pth *.ckpt *.bin *.npy *.npz *.py[cod]

recursive-include requirements *.txt
include third_party/README.md
prune third_party/sglang
prune .cache
prune .git
